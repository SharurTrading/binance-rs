    },
    {
      "name": "ReferencePrice",
      "path": "/{symbol}@referencePrice",
      "route": "market",
      "type": "ReferencePriceEvent"
    },
    {
      "name": "RollingWindowTicker",
      "path": "/{symbol}@ticker_{windowSize}",
      "route": "market",
      "type": "RollingWindowTickerEvent"
    },
    {
      "name": "Ticker",
      "path": "/{symbol}@ticker",
      "route": "market",
      "type": "TickerEvent"
    },
    {
